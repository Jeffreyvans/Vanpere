# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000
# Leave DATABASE_URL empty for SQLite in local dev
DATABASE_URL=
TIME_ZONE=Africa/Harare
# Storage: local or s3
STORAGE_BACKEND=local
MEDIA_ROOT=media
# Object storage - Filebase (S3-compatible). Set STORAGE_BACKEND=s3 to enable.
# Non-secret defaults for the vanpere bucket; leave the keys empty here and set
# them only in the server environment (Render dashboard) - never commit them.
AWS_S3_ENDPOINT_URL=https://s3.filebase.io
AWS_S3_REGION_NAME=auto
AWS_STORAGE_BUCKET_NAME=vanpere
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_S3_ADDRESSING_STYLE=path
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Legacy names are still accepted if AWS_* is not set:
# S3_ENDPOINT_URL= S3_REGION= S3_BUCKET= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= S3_ADDRESSING_STYLE=
# Email (file-based locally; SMTP in production via EMAIL_BACKEND)
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=VanPere Digital <no-reply@example.com>
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
REPORT_AUTO_HIDE_THRESHOLD=3
DEFAULT_EVENT_EXPIRY_DAYS=90
# Upload rate limits (per hour)
UPLOAD_RATE_PER_DEVICE=120
UPLOAD_RATE_PER_IP=400
REPORT_RATE_PER_DEVICE=20
REPORT_RATE_PER_IP=100
# Dashboard
ORGANISER_QUOTA_MB=2048
ZIP_MAX_PHOTOS=2000
ZIP_WARN_PHOTOS=500
# Operations
EXPIRY_WARNING_DAYS=7,1
PURGE_GRACE_DAYS=14
ORPHAN_MAX_AGE_HOURS=24
LOG_LEVEL=INFO
# Built-in administrator (set the password in the real environment, never commit it)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
